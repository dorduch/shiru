<?xml version="1.0" encoding="utf-8"?>
<!--
  Permits cleartext (HTTP) traffic ONLY to loopback/emulator hosts, so a physical
  device bridged with `adb reverse` can reach the local Firebase Emulator Suite.
  Safe in production: the app never sends real traffic to these addresses.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.7.16</domain>
    </domain-config>
</network-security-config>
